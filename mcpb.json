{
    "name": "moltbot-mcp",
    "version": "0.1.0",
    "type": "server",
    "runtime": "python",
    "entry_point": "src/moltbot_mcp/mcp_server.py",
    "dependencies": [
        "fastmcp>=2.14.4,<3.0.0",
        "pydantic>=2.0.0",
        "pydantic-settings>=2.0.0",
        "httpx>=0.27.0",
        "python-dotenv>=1.0.0"
    ],
    "build": {
        "include": [
            "src/**/*",
            "README.md",
            "LICENSE",
            "mcpb/manifest.json",
            "mcpb/prompts/**/*",
            "mcpb/assets/**/*"
        ],
        "exclude": [
            "tests/",
            ".git/",
            "__pycache__/",
            "*.pyc",
            ".venv/",
            "dist/",
            "build/",
            "target/",
            "docs/",
            "scripts/",
            "webapp/"
        ]
    },
    "scripts": {
        "build": "mcpb build",
        "pack": "mcpb pack . dist/moltbot-mcp.mcpb",
        "test": "python -m pytest"
    }
}